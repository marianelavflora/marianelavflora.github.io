---
// 02 — the big timeline: projects, jobs, volunteering, certifications,
// education and life milestones in one line, newest first and grouped by year. Next to the main
// line, a blue lane and a green lane show how long each job and each
// volunteering role lasted. It reads the data
// files (projects.yaml, experience.yaml, certifications.yaml, education.yaml,
// milestones.yaml),
// so adding an entry to any of them puts it on the timeline in the right spot.
import { getCollection } from 'astro:content';
import { en, es, dateRange, expectedRange, monthYear, type Text } from '../i18n';
import { ui } from '../i18n/ui';
import SectionHeading from './SectionHeading.astro';
import ProjectCard from './ProjectCard.astro';
import JourneyLanes, { type Lane } from './JourneyLanes.astro';

type Kind = 'project' | 'job' | 'volunteering' | 'cert' | 'education' | 'life';

const projects = (await getCollection('projects'))
  .filter(p => !p.data.hidden)
  .map(p => ({ kind: 'project' as const, id: p.id, date: p.data.date, order: p.data.order, project: p.data }));
const experience = (await getCollection('experience')).map(e => ({
  kind: e.data.kind,
  id: e.id,
  date: e.data.start,
  order: e.data.order,
  exp: e.data,
}));
const certs = (await getCollection('certifications')).map(c => ({
  kind: 'cert' as const,
  date: c.data.date,
  order: c.data.order,
  cert: c.data,
}));

const education = (await getCollection('education')).map(d => ({
  kind: 'education' as const,
  date: d.data.start,
  order: d.data.order,
  degree: d.data,
}));

// A year-only milestone sorts as January of that year.
const milestones = (await getCollection('milestones')).map(m => ({
  kind: 'life' as const,
  date: m.data.date.length === 4 ? `${m.data.date}-01` : m.data.date,
  order: m.data.order,
  milestone: m.data,
}));

// Newest first; within the same month, projects first, then jobs, volunteering, certs, education, life.
const rank: Record<Kind, number> = { project: 0, job: 1, volunteering: 2, cert: 3, education: 4, life: 5 };
const entries = [...projects, ...experience, ...certs, ...education, ...milestones]
  .sort((a, b) => b.date.localeCompare(a.date) || rank[a.kind] - rank[b.kind] || a.order - b.order)
  .map((e, row) => ({ ...e, row }));

// Lanes. Rows run newest first, so a job is drawn from the first row at or
// before its end month (row 0 if it's still going) down to its own row,
// where it stops at a dot.
const months = (ym: string) => Number(ym.slice(0, 4)) * 12 + Number(ym.slice(5, 7)) - 1;
const today = new Date();
const thisMonth = today.getFullYear() * 12 + today.getMonth();
const duration = (start: string, end: string | null): Text => {
  const total = (end ? months(end) : thisMonth) - months(start) + 1;
  const y = Math.floor(total / 12), m = total % 12;
  const part = (n: number, unit: string) => (n ? `${n}${unit}` : '');
  return {
    en: [part(y, 'y'), part(m, 'm')].filter(Boolean).join(' '),
    es: [part(y, 'a'), part(m, 'm')].filter(Boolean).join(' '),
  };
};
const spans = entries.flatMap(e =>
  e.kind === 'job' || e.kind === 'volunteering'
    ? [{
        kind: e.kind,
        from: entries.findIndex(o => months(o.date) <= (e.exp.end ? months(e.exp.end) : thisMonth)),
        to: e.row,
        pill: duration(e.exp.start, e.exp.end),
      }]
    : [],
);
const laneKinds = ['job', 'volunteering'] as const;
const lanesAt = (row: number): Lane[] =>
  laneKinds.flatMap(kind => {
    const mine = spans.filter(s => s.kind === kind && s.from <= row && row <= s.to);
    if (mine.length === 0) return [];
    const start = mine.find(s => s.to === row);
    const state = mine.some(s => s.to !== row) ? 'full' : 'start';
    return [{ kind, state, pill: start?.pill }];
  });
// A year heading carries a lane when it's still going from the row above.
const lanesAbove = (row: number): Lane[] =>
  laneKinds.flatMap(kind =>
    spans.some(s => s.kind === kind && s.from < row && row <= s.to) ? [{ kind, state: 'full' as const }] : [],
  );

const years = [...new Set(entries.map(e => e.date.slice(0, 4)))].map(year => ({
  year,
  entries: entries.filter(e => e.date.startsWith(year)),
}));

const filters: { kind: Kind; label: Text }[] = [
  { kind: 'project', label: ui.journey.filter.project },
  { kind: 'job', label: ui.journey.filter.job },
  { kind: 'volunteering', label: ui.journey.filter.volunteering },
  { kind: 'cert', label: ui.journey.filter.cert },
  { kind: 'education', label: ui.journey.filter.education },
  { kind: 'life', label: ui.journey.filter.life },
];
const count = (kind: Kind) => entries.filter(e => e.kind === kind).length;
---
<section id="journey" class="section dark-section">
  <div class="wrap">
    <SectionHeading kicker={ui.journey.kicker} title={ui.journey.title} hint={ui.journey.hint} />

    <div class="jr-filters" role="group" aria-label="Filter the timeline">
      <span class="jr-filters-label" {...es(ui.journey.filter.show)}>{en(ui.journey.filter.show)}</span>
      {filters.map(f => (
        <button type="button" class={`jr-chip jr-${f.kind}`} data-filter={f.kind} aria-pressed="true">
          <i aria-hidden="true">✓</i><span {...es(f.label)}>{en(f.label)}</span> <small>{count(f.kind)}</small>
        </button>
      ))}
      <button type="button" class="jr-show-all" hidden {...es(ui.journey.filter.all)}>{en(ui.journey.filter.all)}</button>
    </div>
    <p class="photo-hint" {...es(ui.journey.photoHint)}>{en(ui.journey.photoHint)}</p>

    <div class="jr-lane-labels" aria-hidden="true">
      <span class="jr-job" {...es(ui.journey.lanes.job)}>{en(ui.journey.lanes.job)}</span>
      <span class="jr-volunteering" {...es(ui.journey.lanes.volunteering)}>{en(ui.journey.lanes.volunteering)}</span>
      <span class="jr-main" {...es(ui.journey.lanes.all)}>{en(ui.journey.lanes.all)}</span>
    </div>

    {years.map(({ year, entries }) => (
      <div class="jr-year-group">
        <div class="jr-year-head">
          <JourneyLanes lanes={lanesAbove(entries[0].row)} />
          <h3 class="jr-year">{year}</h3>
        </div>
        <ol class="jr-list">
          {entries.map(e => {
            if (e.kind === 'project') {
              const date = monthYear(e.date);
              return (
                <li class="jr-item jr-project" data-kind="project" id={`journey-${e.id}`}>
                  <span class="jr-date" {...es(date)}>{date.en}</span>
                  <JourneyLanes lanes={lanesAt(e.row)} />
                  <ProjectCard project={e.project} />
                </li>
              );
            }
            if (e.kind === 'cert') {
              const { cert } = e;
              const date = monthYear(cert.date);
              return (
                <li class="jr-item jr-cert" data-kind="cert">
                  <span class="jr-date" {...es(date)}>{date.en}</span>
                  <JourneyLanes lanes={lanesAt(e.row)} />
                  <a class="jr-mini" href={cert.url} target="_blank" rel="noopener">
                    <span class="jr-logo"><img src={cert.icon} alt="" /></span>
                    <span class="jr-text">
                      <span class="jr-kind" {...es(ui.journey.kind.cert)}>{en(ui.journey.kind.cert)}</span>
                      <strong {...es(cert.title)}>{en(cert.title)}</strong>
                      <span class="jr-sub">{cert.issuer}</span>
                    </span>
                  </a>
                </li>
              );
            }
            if (e.kind === 'education') {
              const { degree } = e;
              const dates = degree.end ? dateRange(degree.start, degree.end) : expectedRange(degree.start, degree.expected);
              return (
                <li class="jr-item jr-education" data-kind="education">
                  <span class="jr-date" {...es(dates)}>{en(dates)}</span>
                  <JourneyLanes lanes={lanesAt(e.row)} />
                  <div class="jr-mini">
                    <span class="jr-logo"><img src={degree.logo} alt={degree.logoAlt} /></span>
                    <span class="jr-text">
                      <span class="jr-kind" {...es(ui.journey.kind.education)}>{en(ui.journey.kind.education)}</span>
                      <strong>
                        <span {...es(degree.title)}>{en(degree.title)}</span>
                        {!degree.end && <span class="jr-now" {...es(ui.journey.studying)}>{en(ui.journey.studying)}</span>}
                      </strong>
                      <span class="jr-sub" {...es(degree.school)}>{en(degree.school)}</span>
                    </span>
                  </div>
                </li>
              );
            }
            if (e.kind === 'life') {
              const { milestone: m } = e;
              const date = m.date.length === 4 ? m.date : monthYear(m.date);
              const Tag = m.link ? 'a' : 'div';
              const linkProps = m.link ? { href: m.link.url, target: '_blank', rel: 'noopener' } : {};
              return (
                <li class="jr-item jr-life" data-kind="life">
                  <span class="jr-date" {...es(date)}>{en(date)}</span>
                  <JourneyLanes lanes={lanesAt(e.row)} />
                  <Tag class="jr-mini" {...linkProps}>
                    <span class={m.image ? 'jr-logo jr-photo' : 'jr-logo'}><img src={m.image ?? m.icon} alt={m.alt} loading="lazy" /></span>
                    <span class="jr-text">
                      <span class="jr-kind" {...es(ui.journey.kind.life)}>{en(ui.journey.kind.life)}</span>
                      <strong {...es(m.title)}>{en(m.title)}</strong>
                      <span class="jr-sub" {...es(m.text)}>{en(m.text)}</span>
                      {m.link && <span class="jr-link">{m.link.label} ↗</span>}
                    </span>
                  </Tag>
                </li>
              );
            }
            const { exp } = e;
            const dates = dateRange(exp.start, exp.end);
            const kindLabel = ui.journey.kind[e.kind];
            return (
              <li class={`jr-item jr-${e.kind}`} data-kind={e.kind} id={`journey-${e.id}`}>
                <span class="jr-date" {...es(dates)}>{en(dates)}</span>
                <JourneyLanes lanes={lanesAt(e.row)} />
                <div class="jr-mini">
                  <span class="jr-logo"><img src={exp.logo} alt={exp.logoAlt} /></span>
                  <span class="jr-text">
                    <span class="jr-kind" {...es(kindLabel)}>{en(kindLabel)}</span>
                    <strong>
                      <span {...es(exp.title)}>{en(exp.title)}</span>
                      {!exp.end && <span class="jr-now" {...es(ui.journey.now)}>{en(ui.journey.now)}</span>}
                    </strong>
                    <span class="jr-sub"><span {...es(exp.org)}>{en(exp.org)}</span> · <span {...es(exp.location)}>{en(exp.location)}</span></span>
                  </span>
                </div>
              </li>
            );
          })}
        </ol>
      </div>
    ))}
  </div>

  <!-- big view for project photos, opened from src/scripts/main.js -->
  <dialog class="photo-lightbox" id="photo-lightbox" aria-label="Photo">
    <button type="button" class="lb-close" data-lb-close aria-label="Close">✕</button>
    <button type="button" class="lb-nav lb-prev" data-lb-step="-1" aria-label="Previous photo">‹</button>
    <figure><img alt="" /><figcaption></figcaption></figure>
    <button type="button" class="lb-nav lb-next" data-lb-step="1" aria-label="Next photo">›</button>
  </dialog>
</section>

<script>
  // Each chip turns its kind on or off, so several kinds can show at once.
  // Year headings that end up empty are hidden too. Turning the last kind off
  // (or clicking "Show all") brings everything back.
  const chips = [...document.querySelectorAll<HTMLButtonElement>('.jr-chip')];
  const showAll = document.querySelector<HTMLButtonElement>('.jr-show-all')!;
  const groups = document.querySelectorAll<HTMLElement>('.jr-year-group');
  const journey = document.getElementById('journey')!;
  const active = new Set(chips.map(c => c.dataset.filter));

  function render() {
    if (active.size === 0) chips.forEach(c => active.add(c.dataset.filter));
    chips.forEach(c => c.setAttribute('aria-pressed', String(active.has(c.dataset.filter))));
    showAll.hidden = active.size === chips.length;
    // the blue and green lanes go away with their kind
    journey.dataset.off = chips.map(c => c.dataset.filter).filter(k => !active.has(k)).join(' ');
    groups.forEach(group => {
      let visible = 0;
      group.querySelectorAll<HTMLElement>('.jr-item').forEach(item => {
        const show = active.has(item.dataset.kind);
        item.hidden = !show;
        if (show) visible++;
      });
      group.hidden = visible === 0;
    });
  }

  chips.forEach(chip => {
    chip.addEventListener('click', () => {
      const kind = chip.dataset.filter;
      if (active.has(kind)) active.delete(kind);
      else active.add(kind);
      render();
    });
  });
  showAll.addEventListener('click', () => {
    chips.forEach(c => active.add(c.dataset.filter));
    render();
  });
  // Links from elsewhere on the page (e.g. the Stack tiles) jump to an entry;
  // if a filter is hiding it, show everything first so the jump lands.
  document.querySelectorAll<HTMLAnchorElement>('a[href^="#journey-"]').forEach(link => {
    link.addEventListener('click', () => {
      if (document.querySelector<HTMLElement>(link.hash)?.hidden) showAll.click();
    });
  });
</script>
