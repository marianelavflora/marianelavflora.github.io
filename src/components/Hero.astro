---
import { en, es } from '../i18n';
import { ui } from '../i18n/ui';
---
<section id="top" class="hero">
  <svg class="topo" viewBox="0 0 400 400" aria-hidden="true">
    <g fill="none" stroke="#1a1a1a" stroke-width="1" opacity="0.35">
      <path d="M-20 60 Q100 -10 220 50 T420 40"/>
      <path d="M-30 100 Q90 40 210 95 T430 85"/>
      <path d="M-30 140 Q100 90 230 140 T440 130"/>
      <path d="M-30 180 Q110 130 240 178 T440 175"/>
      <path d="M-30 220 Q120 175 250 215 T440 215"/>
      <circle cx="60" cy="70" r="90"/>
      <circle cx="60" cy="70" r="130"/>
      <circle cx="60" cy="70" r="170"/>
    </g>
  </svg>

  <div class="wrap hero-inner">
    <div class="hero-copy">
      <p class="hero-eyebrow" {...es(ui.hero.eyebrow)} set:html={en(ui.hero.eyebrow)} />
      <h1 class="hero-title" {...es(ui.hero.title)} set:html={en(ui.hero.title)} />
      <p class="rotator-line">
        <span id="rotator" class="rotator">SOFTWARE ENGINEER</span>
      </p>
      <p class="hero-sub" {...es(ui.hero.sub)} set:html={en(ui.hero.sub)} />

      <div class="hero-socials">
        <a href="https://github.com/marianelavflora" target="_blank" rel="noopener" aria-label="GitHub">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.73.5.5 5.73.5 12c0 5.08 3.29 9.38 7.86 10.9.57.1.78-.25.78-.55 0-.27-.01-1.16-.02-2.11-3.2.7-3.88-1.36-3.88-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.75 2.69 1.25 3.34.96.1-.75.4-1.25.73-1.54-2.56-.29-5.26-1.28-5.26-5.7 0-1.26.45-2.29 1.18-3.09-.12-.29-.51-1.46.11-3.05 0 0 .96-.31 3.15 1.18a10.9 10.9 0 0 1 5.73 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.59.23 2.76.11 3.05.74.8 1.18 1.83 1.18 3.09 0 4.43-2.7 5.4-5.28 5.69.42.36.78 1.08.78 2.18 0 1.57-.01 2.84-.01 3.23 0 .3.2.66.79.55A11.5 11.5 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5Z"/></svg>
          <span>GitHub</span>
        </a>
        <a href="https://www.linkedin.com/in/marianela-victoria-flora/" target="_blank" rel="noopener" aria-label="LinkedIn">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.38-1.85 3.61 0 4.28 2.38 4.28 5.47v6.27ZM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45Z"/></svg>
          <span>LinkedIn</span>
        </a>
        <a href="https://x.com/mavifloraa" target="_blank" rel="noopener" aria-label="X / Twitter">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.24 2.25h3.03l-6.62 7.56 7.79 10.94h-6.1l-4.78-6.5-5.47 6.5H2.06l7.08-8.09L1.66 2.25h6.25l4.32 5.94 5.99-5.94Zm-1.06 16.6h1.68L7.9 4.05H6.1l11.08 14.8Z"/></svg>
          <span>X</span>
        </a>
        <a class="cv-btn hero-cv-btn" href="/assets/cv/MaViFlora_CV.pdf" data-cv-trigger {...es(ui.nav.cv)}>{en(ui.nav.cv)}</a>
      </div>
    </div>

    <figure class="hero-photo">
      <img src="/assets/img/mavi-robot.jpg" alt="MaVi posing with a vintage TOMY Omnibot robot" />
      <figcaption>
        <span {...es(ui.hero.caption)}>{en(ui.hero.caption)}</span>
        <a class="hero-photo-link" href="https://x.com/gauchopaisano" target="_blank" rel="noopener" {...es(ui.hero.gauchoX)}>{en(ui.hero.gauchoX)}</a>
      </figcaption>
    </figure>
  </div>
</section>
