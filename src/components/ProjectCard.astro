---
import type { CollectionEntry } from 'astro:content';
import { en, es } from '../i18n';
import { ui } from '../i18n/ui';

interface Props {
  project: CollectionEntry<'projects'>['data'];
}
const { type, typeLabel, status, tech, event, product } = Astro.props.project;
const typeTag = typeLabel ?? ui.type[type];
const productLabel = ui.back[product.label];
// Skip the product's title when it just repeats the event's name.
const productTitle = en(product.title) === event.title ? null : product.title;
// The photos the card swaps between: the event, then what came out of it.
// Missing photos are left out; a card with none has no photo area at all.
const photos = [
  { image: event.image, alt: event.alt ?? event.title, label: ui.eventPhoto },
  { image: product.image, alt: product.alt ?? en(product.title), label: productLabel },
].filter(p => p.image);
---
<article class:list={['card', 'project-card', { 'no-media': photos.length === 0 }]}>
  {photos.length > 0 && (
    <div class="card-media card-photos" data-photos>
      {photos.map((p, i) => (
        <figure class:list={['card-photo', { active: i === 0 }]}>
          <button type="button" class="card-photo-open" data-full={p.image} aria-label={`Open photo: ${p.alt}`}>
            <img src={p.image} alt={p.alt} loading="lazy" />
          </button>
          <figcaption class="card-photo-label" {...es(p.label)}>{en(p.label)}</figcaption>
        </figure>
      ))}
      {photos.length > 1 && (
        <>
          <button type="button" class="card-photo-nav card-photo-prev" data-photo-step="-1" aria-label="Previous photo">‹</button>
          <button type="button" class="card-photo-nav card-photo-next" data-photo-step="1" aria-label="Next photo">›</button>
          <div class="card-photo-dots" aria-hidden="true">{photos.map((_, i) => <i class:list={{ active: i === 0 }}></i>)}</div>
        </>
      )}
    </div>
  )}
  <div class="card-body">
    {status
      ? (
        <div class="tag-row">
          <span class={`tag tag-${type}`} {...es(typeTag)}>{en(typeTag)}</span>
          <span class={`tag tag-status tag-${status.kind}`} {...es(status.label)}>{en(status.label)}</span>
        </div>
      )
      : <span class={`tag tag-${type}`} {...es(typeTag)}>{en(typeTag)}</span>}
    <h3>{event.title}</h3>
    <p>
      <span {...es(event.text)}>{en(event.text)}</span>{' '}
      {productTitle && <><strong {...es(productTitle)}>{en(productTitle)}</strong>:{' '}</>}
      <span {...es(product.text)}>{en(product.text)}</span>
    </p>
    {tech.length > 0 && (
      <ul class="card-tech" aria-label="Tech used">
        {tech.map(t => <li {...es(t)}>{en(t)}</li>)}
      </ul>
    )}
    {product.links.length > 0 && (
      <div class="card-links">
        {product.links.map(link => <a href={link.url} target="_blank" rel="noopener">{link.label}</a>)}
      </div>
    )}
    <p class="card-meta" {...es(event.meta)}>{en(event.meta)}</p>
  </div>
</article>
