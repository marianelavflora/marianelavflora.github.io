---
// Education: one card per degree, with a bar showing how far along it is.
import { getCollection } from 'astro:content';
import { en, es, fileOrder, expectedRange, dateRange } from '../i18n';
import SectionHeading from './SectionHeading.astro';

const degrees = fileOrder(await getCollection('education')).map(({ data }) => {
  const from = Number(data.start.slice(0, 4)) + (Number(data.start.slice(5)) - 1) / 12;
  const to = data.end ? Number(data.end.slice(0, 4)) + 1 : (data.expected ?? from) + 1;
  const now = new Date().getFullYear() + new Date().getMonth() / 12;
  const pct = Math.max(0, Math.min(100, Math.round(((now - from) / (to - from)) * 100)));
  return { ...data, pct };
});
---
<section id="education" class="section dark-section">
  <div class="wrap">
    <SectionHeading kicker={{ en: '04 — where I study', es: '04 — dónde estudio' }} title={{ en: 'Education', es: 'Educación' }} />
    <div class="edu-grid">
      {degrees.map(d => {
        const dates = d.end ? dateRange(d.start, d.end) : expectedRange(d.start, d.expected);
        return (
          <div class="edu-card">
            <div class="edu-head">
              <span class="jr-logo"><img src={d.logo} alt={d.logoAlt} /></span>
              <div>
                <h3 {...es(d.title)}>{en(d.title)}</h3>
                <p class="jr-sub" {...es(d.school)}>{en(d.school)}</p>
              </div>
            </div>
            <div class="edu-bar"><span style={`width:${d.pct}%`}></span></div>
            <p class="edu-dates"><span {...es(dates)}>{en(dates)}</span><b>{d.pct}%</b></p>
          </div>
        );
      })}
    </div>
  </div>
</section>
