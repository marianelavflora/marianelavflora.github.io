---
import { getCollection } from 'astro:content';
import { en, es, fileOrder } from '../i18n';
import { ui } from '../i18n/ui';
import SectionHeading from './SectionHeading.astro';

const groups = fileOrder(await getCollection('stack'));
// Plain-text chips and { label, note, current } chips, in one shape.
const chip = item => (typeof item === 'object' && 'label' in item ? item : { label: item });
---
<section id="stack" class="section dark-section">
  <div class="wrap">
    <SectionHeading kicker={ui.stack.kicker} title={ui.stack.title} />
    <div class="stack-grid">
      {groups.map(({ data: group }) => (
        <div class="stack-group">
          <h3><span class="stack-icon">{group.icon}</span> <span {...es(group.title)}>{en(group.title)}</span></h3>
          <ul class="stack-chips">
            {group.items.map(chip).map(({ label, note, current }) => (
              <li class:list={{ current }}>
                {current && <i class="stack-current-dot" aria-hidden="true"></i>}
                <span {...es(label)}>{en(label)}</span>
                {note && <small {...es(note)}>{en(note)}</small>}
                {current && <span class="sr-only" {...es(ui.stack.current)}>{en(ui.stack.current)}</span>}
              </li>
            ))}
          </ul>
          {group.items.some(item => chip(item).current) && (
            <p class="stack-legend"><i class="stack-current-dot" aria-hidden="true"></i> <span {...es(ui.stack.current)}>{en(ui.stack.current)}</span></p>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
