---
import { getCollection } from 'astro:content';
import { en, es, newestFirst } from '../i18n';
import { ui } from '../i18n/ui';
import SectionHeading from './SectionHeading.astro';
import ProjectCard from './ProjectCard.astro';

const all = await getCollection('projects');
const projects = newestFirst(all.filter(p => !p.data.hidden), p => p.data.date);
---
<section id="projects" class="section dark-section">
  <div class="wrap">
    <SectionHeading kicker={ui.projects.kicker} title={ui.projects.title} hint={ui.projects.hint} />
    <p class="flip-hint" {...es(ui.projects.flipHint)} set:html={en(ui.projects.flipHint)} />

    <ol class="timeline">
      {projects.map(p => <ProjectCard project={p.data} />)}
    </ol>
  </div>
</section>
